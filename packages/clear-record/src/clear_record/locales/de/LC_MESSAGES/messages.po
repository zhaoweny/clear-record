#: packages/clear-record/src/clear_record/cli/cli.py:73
msgid "clear-record: from many recordings to one clear record."
msgstr "clear-record: aus vielen Aufnahmen ein klares Protokoll."

#: packages/clear-record/src/clear_record/cli/cli.py:76
msgid ""
"raise diagnostics log detail (the flag form of CR_LOG_LEVEL=debug); the "
"log is written to the app state directory, never to stdout"
msgstr ""
"Diagnoseprotokoll ausführlicher (die Flag-Form von CR_LOG_LEVEL=debug); "
"das Protokoll wird im App-Zustandsverzeichnis geschrieben, nie auf stdout"

#: packages/clear-record/src/clear_record/cli/cli.py:218
msgid ""
"--split-channels and --mix-down are mutually exclusive; pass one or "
"neither."
msgstr ""
"--split-channels und --mix-down schließen sich gegenseitig aus; gib eines"
" oder keines an."

#: packages/clear-record/src/clear_record/cli/cli.py:233
msgid "--diarize and --no-diarize are mutually exclusive; pass one or neither."
msgstr ""
"--diarize und --no-diarize schließen sich gegenseitig aus; gib eines oder"
" keines an."

#: packages/clear-record/src/clear_record/cli/cli.py:593
#, python-brace-format
msgid ""
"[auto] the recommended model {model!r} is not in the models directory, "
"and --auto never downloads one.\n"
"  Pre-fetch it, e.g. `hf download ggerganov/whisper.cpp ggml-{model}.bin "
"--local-dir {models_dir}`, or pass an explicit `--model`."
msgstr ""
"[auto] das empfohlene Modell {model!r} ist nicht im Modellverzeichnis, "
"und --auto lädt keines herunter.\n"
"  Lade es vorab, z. B. `hf download ggerganov/whisper.cpp "
"ggml-{model}.bin --local-dir {models_dir}`, oder gib ein explizites "
"`--model` an."

#: packages/clear-record/src/clear_record/cli/cli.py:777
msgid ""
"run the pipeline and report transcript quality against a reference if "
"given"
msgstr ""
"führt die Pipeline aus und meldet die Transkriptqualität gegen eine "
"Referenz, falls angegeben"

#: packages/clear-record/src/clear_record/cli/cli.py:792
msgid "assign speaker labels to already-transcribed segments"
msgstr "weist bereits transkribierten Segmenten Sprecherbezeichnungen zu"

#: packages/clear-record/src/clear_record/cli/cli.py:799
msgid "re-attribute speakers by relative source energy (close-mic cross-talk)"
msgstr ""
"weist Sprecher anhand der relativen Quellenenergie neu zu "
"(Nahbesprechung/Übersprechen)"

#: packages/clear-record/src/clear_record/cli/cli.py:806
msgid "show or append to the workspace glossary (ASR initial prompt)"
msgstr "zeigt das Workspace-Glossar an oder hängt daran an (ASR-Anfangsprompt)"

#: packages/clear-record/src/clear_record/cli/cli.py:813
msgid ""
"generate a clean scene + degraded per-device recordings with exact ground"
" truth"
msgstr ""
"erzeugt eine saubere Szene + degradierte Aufnahmen je Gerät mit exakter "
"Ground Truth"

#: packages/clear-record/src/clear_record/cli/cli.py:820
msgid "list which ASR backends are currently available"
msgstr "listet auf, welche ASR-Backends derzeit verfügbar sind"

#: packages/clear-record/src/clear_record/web/__init__.py:36
#, python-brace-format
msgid ""
"[web] the web console needs the optional 'web' extra ({missing} not "
"found).\n"
"  Install it with:   pip install 'clear-record[web]'\n"
"  Or run without installing:   uvx --from 'clear-record[web]' clear-"
"record web"
msgstr ""
"[web] die Web-Konsole benötigt das optionale 'web'-Extra ({missing} nicht"
" gefunden).\n"
"  Installiere es mit:   pip install 'clear-record[web]'\n"
"  Oder führe sie ohne Installation aus:   uvx --from 'clear-record[web]' "
"clear-record web"

#: packages/clear-record/src/clear_record/web/__init__.py:63
msgid "start the local web console (projects, glossary) in a browser"
msgstr "startet die lokale Web-Konsole (Projekte, Glossar) im Browser"

#: packages/clear-record/src/clear_record/web/__init__.py:68
msgid "bind address (default localhost)"
msgstr "Bind-Adresse (Standard localhost)"

#: packages/clear-record/src/clear_record/web/__init__.py:71
msgid "port (default 8765)"
msgstr "Port (Standard 8765)"

#: packages/clear-record/src/clear_record/web/__init__.py:73
msgid "do not open a browser window"
msgstr "kein Browserfenster öffnen"

#: packages/clear-record/src/clear_record/web/__init__.py:79
msgid "override the app data directory (default: CR_DATA_DIR / XDG)"
msgstr "App-Datenverzeichnis überschreiben (Standard: CR_DATA_DIR / XDG)"

#: packages/clear-record/src/clear_record/web/__init__.py:85
msgid ""
"set up Tailscale Serve for this port, trust this machine's tailnet name, "
"and print its https URL. Serve runs in the foreground alongside the "
"console and stops with it. The tailnet is the authentication: anyone on "
"your tailnet can reach the console."
msgstr ""
"richtet Tailscale Serve für diesen Port ein, vertraut dem Tailnet-Namen "
"dieser Maschine und gibt dessen https-URL aus. Serve läuft im Vordergrund"
" neben der Konsole und endet mit ihr. Das Tailnet ist die "
"Authentifizierung: Jeder in deinem Tailnet kann die Konsole erreichen."

#: packages/clear-record/src/clear_record/web/__init__.py:96
msgid ""
"trust NAME instead of the machine's resolved tailnet name (requires "
"--tailscale)"
msgstr ""
"vertraut NAME statt des aufgelösten Tailnet-Namens der Maschine "
"(erfordert --tailscale)"

#: packages/clear-record/src/clear_record/web/__init__.py:106
msgid ""
"the tailnet HTTPS port Serve exposes (default: the same as --port); "
"requires --tailscale"
msgstr ""
"der Tailnet-HTTPS-Port, den Serve bereitstellt (Standard: derselbe wie "
"--port); erfordert --tailscale"

#: packages/clear-record/src/clear_record/web/__init__.py:144
msgid ""
"--tailscale-host / --tailscale-port configure Serve; pass --tailscale too"
" (or set CR_TRUSTED_HOSTS to trust a hostname without Serve)."
msgstr ""
"--tailscale-host / --tailscale-port konfigurieren Serve; gib auch "
"--tailscale an (oder setze CR_TRUSTED_HOSTS, um einem Hostnamen ohne "
"Serve zu vertrauen)."

#: packages/clear-record/src/clear_record/web/__init__.py:152
#, python-brace-format
msgid "--tailscale-port {port} is not a port number (1-65535)."
msgstr "--tailscale-port {port} ist keine Portnummer (1-65535)."

#: packages/clear-record/src/clear_record/web/__init__.py:237
#, python-brace-format
msgid ""
"--tailscale sets up Tailscale Serve against http://127.0.0.1:<port>, but "
"--host {host!r} is not a loopback address, so Serve could not reach the "
"console.\n"
"  Drop --host (the console binds 127.0.0.1 by default), or drop "
"--tailscale and front the loopback console with your own proxy "
"(ADR-0021)."
msgstr ""
"--tailscale richtet Tailscale Serve gegen http://127.0.0.1:<port> ein, "
"aber --host {host!r} ist keine Loopback-Adresse, sodass Serve die Konsole"
" nicht erreichen könnte.\n"
"  Lass --host weg (die Konsole bindet standardmäßig 127.0.0.1), oder lass"
" --tailscale weg und stelle deinen eigenen Proxy vor die Loopback-Konsole"
" (ADR-0021)."

#: packages/clear-record/src/clear_record/web/__init__.py:268
#, python-brace-format
msgid ""
"--tailscale-host {override!r} is not a bare hostname.\n"
"    Fix: pass the name Tailscale gives you, e.g. machine.tailnet.ts.net."
msgstr ""
"--tailscale-host {override!r} ist kein bloßer Hostname.\n"
"    Korrektur: Gib den Namen an, den Tailscale dir gibt, z. B. "
"machine.tailnet.ts.net."

#: packages/clear-record/src/clear_record/web/__init__.py:282
#, python-brace-format
msgid ""
"[tailscale] {error}\n"
"    The console is starting anyway, but it will not be reachable over the"
" tailnet."
msgstr ""
"[tailscale] {error}\n"
"    Die Konsole startet trotzdem, ist aber über das Tailnet nicht "
"erreichbar."

#: packages/clear-record/src/clear_record/web/__init__.py:294
#, python-brace-format
msgid ""
"[tailscale] port {port} is already served by Tailscale; leaving that "
"mapping untouched.\n"
"    If it does not point at this console, pass --tailscale-port <port> to"
" expose a different tailnet port."
msgstr ""
"[tailscale] Port {port} wird bereits von Tailscale bedient; diese "
"Zuordnung bleibt unangetastet.\n"
"    Wenn sie nicht auf diese Konsole zeigt, gib --tailscale-port <port> "
"an, um einen anderen Tailnet-Port bereitzustellen."

#: packages/clear-record/src/clear_record/web/__init__.py:304
#, python-brace-format
msgid ""
"[tailscale] console is now shared on your tailnet:\n"
"    {url}\n"
"    The tailnet is the authentication: anyone on your tailnet can reach "
"this console.\n"
"    Serve runs in the foreground and stops with this console."
msgstr ""
"[tailscale] Die Konsole ist jetzt in deinem Tailnet freigegeben:\n"
"    {url}\n"
"    Das Tailnet ist die Authentifizierung: Jeder in deinem Tailnet kann "
"diese Konsole erreichen.\n"
"    Serve läuft im Vordergrund und endet mit dieser Konsole."

