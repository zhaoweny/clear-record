msgstr "--auto：选择了 {decisions}；输入：{inputs}。"

#: packages/clear-record/src/clear_record/cli/cli.py:81
msgid "clear-record: from many recordings to one clear record."
msgstr "clear-record：从众多录音到一份清晰的记录。"

# Per-option help: left English on purpose (the terminal is not the
# interface).
#: packages/clear-record/src/clear_record/cli/cli.py:84
msgid ""
"raise diagnostics log detail (the flag form of CR_LOG_LEVEL=debug); the "
"log is written to the app state directory, never to stdout"
msgstr ""

#: packages/clear-record/src/clear_record/cli/cli.py:240
msgid ""
"--split-channels and --mix-down are mutually exclusive; pass one or "
"neither."
msgstr "--split-channels 与 --mix-down 互斥；只能二选一，或都不指定。"

#: packages/clear-record/src/clear_record/cli/cli.py:256
msgid "--diarize and --no-diarize are mutually exclusive; pass one or neither."
msgstr "--diarize 与 --no-diarize 互斥；只能二选一，或都不指定。"

#: packages/clear-record/src/clear_record/cli/cli.py:276
#, python-brace-format
msgid ""
"{path} is a file, not a directory: this command expects a directory of "
"audio files."
msgstr "「{path}」是文件而不是目录：本命令需要一个包含音频文件的目录。"

#: packages/clear-record/src/clear_record/cli/cli.py:621
#, python-brace-format
msgid ""
"[auto] the recommended model {model!r} is not in the models directory, "
"and --auto never downloads one.\n"
"  Pre-fetch it, e.g. `hf download ggerganov/whisper.cpp ggml-{model}.bin "
"--local-dir {models_dir}`, or pass an explicit `--model`."
msgstr ""
"[auto] 推荐模型 {model!r} 不在模型目录中，而 --auto 从不下载模型。\n"
"  请预先下载，例如 `hf download ggerganov/whisper.cpp ggml-{model}.bin --local-"
"dir {models_dir}`，或显式指定 `--model`。"

#: packages/clear-record/src/clear_record/cli/cli.py:768
#, python-brace-format
msgid ""
"[next] the record is in {directory}/export; review it and accept the "
"minutes in the console: `clear-record web`"
msgstr "[下一步] 记录位于 {directory}/export；请在控制台中审阅并接受会议纪要：`clear-record web`"

#: packages/clear-record/src/clear_record/cli/cli.py:813
msgid ""
"run the pipeline and report transcript quality against a reference if "
"given"
msgstr "运行流水线，并在给定参考文本时报告转写质量"

#: packages/clear-record/src/clear_record/cli/cli.py:828
msgid "assign speaker labels to already-transcribed segments"
msgstr "为已转写的片段分配说话人标签"

#: packages/clear-record/src/clear_record/cli/cli.py:835
msgid "re-attribute speakers by relative source energy (close-mic cross-talk)"
msgstr "按相对声源能量重新归属说话人（近距麦克风串音）"

#: packages/clear-record/src/clear_record/cli/cli.py:842
msgid "show or append to the workspace glossary (ASR initial prompt)"
msgstr "显示或追加工作区术语表（ASR 初始提示词）"

#: packages/clear-record/src/clear_record/cli/cli.py:849
msgid ""
"generate a clean scene + degraded per-device recordings with exact ground"
" truth"
msgstr "生成干净场景 + 各设备的降质录音，并提供精确的标准答案"

#: packages/clear-record/src/clear_record/cli/cli.py:856
msgid "list which ASR backends are currently available"
msgstr "列出当前可用的 ASR 后端"

#: packages/clear-record/src/clear_record/cli/transcription.py:536
msgid ""
"[transcribe] a re-run scope only means something when cached chunks may "
"be reused, but resume is off; drop one of the two."
msgstr "[transcribe] 只有当缓存片段可能被复用时，重新运行范围才有意义，但 resume 已关闭；请去掉两者之一。"

#: packages/clear-record/src/clear_record/cli/transcription.py:546
#, python-brace-format
msgid ""
"[transcribe] re-run scope names source(s) not in the manifest: {unknown} "
"(available: {available})."
msgstr "[transcribe] 重新运行范围指定了清单中不存在的来源：{unknown}（可用：{available}）。"

#: packages/clear-record/src/clear_record/cli/transcription.py:569
#, python-brace-format
msgid ""
"[transcribe] re-run scope ({scope}) selects no chunk of {looked_at}; it "
"would re-decode nothing. Widen the range or drop the scope."
msgstr "[transcribe] 重新运行范围（{scope}）没有选中 {looked_at} 的任何片段；不会重新解码任何内容。请放宽范围或去掉该范围。"

#: packages/clear-record/src/clear_record/cli/transcription.py:588
msgid "no decoder worker ran: every chunk was reused from the cache"
msgstr "没有解码工作进程运行：所有分块均复用了缓存"

#: packages/clear-record/src/clear_record/cli/transcription.py:591
msgid "no decoder worker's memory could be sampled during the transcribe stage"
msgstr "转写阶段无法采样任何解码工作进程的内存"

#: packages/clear-record/src/clear_record/cli/transcription.py:594
msgid "peak worker memory is not measurable on this platform"
msgstr "该平台无法测量工作进程峰值内存"

#: packages/clear-record/src/clear_record/cli/transcription.py:869
#, python-brace-format
msgid ""
"[transcribe] backend '{backend}' cannot honour decoder option(s): "
"{unsupported}. It supports: {supported}."
msgstr "[transcribe] 后端 '{backend}' 无法支持解码器选项：{unsupported}。它支持：{supported}。"

#: packages/clear-record/src/clear_record/core/paths.py:187
#, python-brace-format
msgid ""
"clear-record: adopting the existing pre-platformdirs {label} directory at"
" {legacy}; move it to {native} for the platform-native layout "
