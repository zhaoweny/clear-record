# Local temp folder — per-session scratch, handoff notes, state (see .local/)
.local/

# Agent worktrees (see docs/agents/git-worktree.toml when adopted)
.wt/
wt-*

# Local issue tracker (see docs/agents/issue-tracker.md)
.scratch/

# Local pipeline workspace (sources + derived artifacts; environment-local only)
workspace/

# Environment files (keep .env.example if added)
.env
.env.*
!.env.example

# Audio / dataset / model artifacts are environment-local data, never git.
# Large recordings, downloaded model weights, caches and intermediate
# artifacts do not belong in the repository. See docs/architecture.md §6 & §8.
recordings/
data/
models/
cache/
artifacts/
*.wav
*.flac
*.ogg
*.opus
*.mp3
*.m4a
*.aac
*.pt
*.bin
*.onnx
*.srt
*.vtt

