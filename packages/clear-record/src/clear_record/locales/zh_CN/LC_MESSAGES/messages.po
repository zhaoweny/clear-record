msgstr "无法读取重跑范围 {whole!r}：应为 START-END（例如 12:30-18:00 或 745-1050）。"

#: packages/clear-record/src/clear_record/core/scope.py:117
#, python-brace-format
msgid ""
"re-run range {whole!r} ends at or before it starts; the end must be later"
