msgstr "再次输入密码"

#: packages/clear-record/src/clear_record/web/templates/auth.html:31
#, python-brace-format
msgid "At least {count} characters."
msgstr "至少 {count} 个字符。"

#: packages/clear-record/src/clear_record/web/templates/auth.html:32
msgid "Set password and continue"
msgstr "设置密码并继续"

#: packages/clear-record/src/clear_record/web/templates/auth.html:35
#: packages/clear-record/src/clear_record/web/templates/auth.html:40
msgid "Sign in"
msgstr "登录"

#: packages/clear-record/src/clear_record/web/templates/auth.html:36
msgid ""
"This console asks for the password set on this node. Lost or forgotten, "
"it can be replaced from a terminal where the node runs — the password "
"command needs no session, no browser and no running node."
msgstr "此控制台要求输入在节点上设置的密码。密码遗失或遗忘时，可在运行节点的终端上更换 —— 密码命令无需会话、无需浏览器，也无需正在运行的节点。"

